# Build settings (export explicitly; build does not auto-load this file)
CARTRIDGE_MCP_URL=http://127.0.0.1:54321/functions/v1/mcp
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# MCP runtime settings
CARTRIDGE_TOKEN_AUDIENCE=authenticated
# Optional allowlist. Empty or unset accepts any OAuth client; set to restrict to listed IDs.
CARTRIDGE_OAUTH_CLIENT_IDS=
CARTRIDGE_ALLOWED_ORIGINS=http://127.0.0.1:3000

# Polar default billing; keep credentials server-side
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_CREDITS={"YOUR_PRODUCT_UUID":100}
POLAR_SERVER=sandbox

# Optional legacy Stripe webhook; never expose these in public assets
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREDITS={"price_example":100}
