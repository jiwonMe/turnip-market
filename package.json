{
  "name": "turnip-stalk-market",
  "version": "1.0.0",
  "description": "Agent-native Animal Crossing turnip market on the Cartridge pattern.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./lib/config.d.ts",
      "import": "./lib/config.js"
    },
    "./compiler": {
      "types": "./lib/compiler.d.ts",
      "import": "./lib/compiler.js"
    }
  },
  "files": [
    "lib",
    "supabase/config.toml",
    "supabase/migrations/*.sql",
    "supabase/functions/deno.json",
    "supabase/functions/deno.lock",
    "supabase/functions/mcp/index.ts",
    "supabase/functions/billing-webhook/index.ts",
    "supabase/functions/stripe-webhook/index.ts",
    "supabase/functions/_shared/*.ts",
    "public/oauth/consent/index.html",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && tsx scripts/build-cartridge.ts",
    "build:cartridge": "tsx scripts/build-cartridge.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@polar-sh/sdk": "0.42.5",
    "@supabase/supabase-js": "2.95.3",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
